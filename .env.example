# Database connection URL for PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/esp32_iot_monitor"

# JWT Secret for user session tokens
JWT_SECRET="replace-with-secure-secret-in-production"

# Device offline timeout in seconds (Default: 30)
DEVICE_TIMEOUT_SECONDS=30

# CORS Allowed Origin
CORS_ORIGIN="*"

# Server Port (fixed to 3000 for container ingress)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
